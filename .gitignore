# Maven build output
target/

# Model weights under assets/mdl are ignored by default (large LLM/audio
# models). Explicitly allow known small ones.
assets/mdl/*
!assets/mdl/silero/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
